# FitBot AI Backend Configuration

# AI Provider selection: 'gemini' (Recommended - 100% Free Tier) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
# 15 RPM, 1M TPM, 1,500 RPD completely free with zero credit card needed!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
